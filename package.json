{
  "name": "apex-tech-metais",
  "version": "1.0.0",
  "description": "Landing page and admin panel for Apex Tech Metais, with Node.js Express proxy server",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "cross-env NODE_ENV=test jest",
    "import:fornecedores": "node scripts/import-fornecedores.js",
    "import:clientes": "node scripts/import-clientes.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-format": "^1.0.4",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "resend": "^6.32.1",
    "winston": "^3.19.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@whiskeysockets/baileys$": "<rootDir>/tests/__mocks__/baileys.js"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
