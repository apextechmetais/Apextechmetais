# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.

# Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados (PostgreSQL). Sem esta variável o sistema roda em memória e os dados se perdem ao reiniciar.
DATABASE_URL=postgresql://usuario:senha@host:5432/apextech

# Chave de assinatura dos tokens de login (JWT).
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Sem ela o servidor gera uma chave temporária e todos os usuários são deslogados a cada reinício.
JWT_SECRET=

# Resend (envio de e-mails). O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM=sistema@apextechmetais.com.br
